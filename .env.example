# VirtualBank demo environment. Copy to .env and NEVER commit your .env.
# No cloud/API key needed for the local starter. Internet is required to pull Ollama images/models once.
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-only
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
KEYCLOAK_REALM=virtual-bank
API_PORT=8081

# ACTIVE DEFAULT: local real AI (NOT the deterministic Offline test router).
# On Windows: .\scripts\windows\start-local.ps1
# Ollama is in the optional Compose 'ai' profile; regular `docker compose up` never pulls it.
ASSISTANT_PROVIDER=Ollama
ASSISTANT_MODEL=qwen3:4b-instruct
ASSISTANT_ENDPOINT=http://ollama:11434/v1/
# CPU-only local inference is slow; raise (max 300) if answers time out.
ASSISTANT_TIMEOUT_SECONDS=240
DOCUMENTS_EMBEDDING_PROVIDER=Ollama
DOCUMENTS_EMBEDDING_MODEL=bge-m3
DOCUMENTS_EMBEDDING_ENDPOINT=http://ollama:11434/
DOCUMENTS_EMBEDDING_DIMENSIONS=1024
DOCUMENTS_MIN_SIMILARITY=0.45

# OPTIONAL CLOUD PROVIDER 1: OpenRouter for chat AND embeddings (same API key)
# To switch, comment/remove ALL seven active Ollama provider lines above (including dimensions; ASSISTANT_TIMEOUT_SECONDS may stay),
# then uncomment the chosen provider block AND its API key line below.
# Run `docker compose up -d --build --wait` WITHOUT --profile ai; Ollama is NOT pulled.
# ASSISTANT_PROVIDER=OpenRouter
# ASSISTANT_MODEL=openai/gpt-4o
# ASSISTANT_ENDPOINT=https://openrouter.ai/api/v1
# DOCUMENTS_EMBEDDING_PROVIDER=OpenRouter
# DOCUMENTS_EMBEDDING_MODEL=openai/text-embedding-3-small
# DOCUMENTS_EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1/
# DOCUMENTS_EMBEDDING_DIMENSIONS=1024
# OPENROUTER_API_KEY=

# OPTIONAL CLOUD PROVIDER 2: direct OpenAI for chat AND embeddings
# Uncomment only after disabling the active Ollama provider settings above.
# ASSISTANT_PROVIDER=OpenAI
# ASSISTANT_MODEL=gpt-4o
# ASSISTANT_ENDPOINT=https://api.openai.com/v1
# DOCUMENTS_EMBEDDING_PROVIDER=OpenAI
# DOCUMENTS_EMBEDDING_MODEL=text-embedding-3-small
# DOCUMENTS_EMBEDDING_ENDPOINT=https://api.openai.com/v1/
# DOCUMENTS_EMBEDDING_DIMENSIONS=1024
# OPENAI_API_KEY=

# Deterministic test router (NOT an AI/LLM):
# ASSISTANT_PROVIDER=Offline
# Offline only disables chat inference; RAG still needs the selected embedding provider.

# IMPORTANT: Do not add COMPOSE_PROFILES=ai to .env for cloud mode.
# Switching chat providers does NOT change embedding providers or erase/reindex old vectors.
# Re-run ingestion after changing an embedding model; matching vector lengths do not imply compatibility.
