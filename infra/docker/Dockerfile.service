# Builds the ASP.NET Core API host (VirtualBank.Web). Used by compose.yaml with PROJECT and ASSEMBLY build args.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo
ARG PROJECT
# Restore first so the package layer is cached across source-only changes.
COPY Directory.Build.props Directory.Packages.props ./
COPY src/ src/
COPY tools/ tools/
RUN dotnet restore "$PROJECT"
RUN dotnet publish "$PROJECT" -c Release -o /out --no-restore --nologo

FROM mcr.microsoft.com/dotnet/aspnet:10.0
# Npgsql probes for GSSAPI at connect time; without it every container logs "Cannot load library libgssapi_krb5.so.2".
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
ARG ASSEMBLY
ENV SERVICE_ASSEMBLY=$ASSEMBLY
# Run as the unprivileged user that the official .NET images provide.
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec dotnet \"$SERVICE_ASSEMBLY\""]
