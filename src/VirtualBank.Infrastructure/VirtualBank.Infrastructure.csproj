<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapters for the Application ports: PostgreSQL under RLS (Npgsql), Keycloak/JWT, audit logging,
       and the assistant runtimes (Semantic Kernel + OpenRouter, deterministic offline).
       The only project that knows the database driver and the identity provider. -->
  <PropertyGroup>
    <RootNamespace>VirtualBank.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../VirtualBank.Application/VirtualBank.Application.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VirtualBank.Infrastructure.UnitTests" />
  </ItemGroup>
</Project>
