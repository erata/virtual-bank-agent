{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "VirtualBank.Audit": "Information",
      "VirtualBank.Assistant": "Information"
    }
  },
  "AllowedHosts": "*",
  "Authorization": {
    "MachineClients": [
      "svc-ingestion",
      "svc-reporting"
    ]
  },
  "Assistant": {
    "Provider": "Ollama",
    "Model": "qwen3:4b-instruct",
    "Endpoint": "http://ollama:11434/v1/",
    "MaxOutputTokens": 800,
    "TimeoutSeconds": 240,
    "Limits": {
      "MaxMessageLength": 2000,
      "MaxToolCalls": 6,
      "MaxWriteCalls": 0,
      "MaxAnswerLength": 4000
    }
  },
  "Documents": {
    "Model": "bge-m3",
    "Endpoint": "http://ollama:11434/",
    "SampleDirectory": "/sample-docs",
    "Provider": "Ollama",
    "Dimensions": 1024
  }
}
