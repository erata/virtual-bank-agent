meta {
  name: Token for anna.berater
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{cliClientId}}
  username: anna.berater
  password: {{personaPassword}}
}

script:post-response {
  bru.setVar("annaToken", res.body.access_token);
}

tests {
  test("token issued", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
