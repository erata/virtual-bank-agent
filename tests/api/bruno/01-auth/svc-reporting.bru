meta {
  name: Token for svc-reporting (no business audience)
  type: http
  seq: 5
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: svc-reporting
  client_secret: {{reportingClientSecret}}
}

script:post-response {
  bru.setVar("reportingToken", res.body.access_token);
}

tests {
  test("token issued", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
