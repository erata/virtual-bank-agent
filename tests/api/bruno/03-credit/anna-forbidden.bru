meta {
  name: Advisor gets 403 with deterministic notice
  type: http
  seq: 1
}

get {
  url: {{apiBaseUrl}}/api/credit/applications/K-100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{annaToken}}
}

tests {
  test("status is 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
  test("notice code is CREDIT_READ_REQUIRED", function() {
    expect(res.getBody().noticeCode).to.equal("CREDIT_READ_REQUIRED");
  });
}
